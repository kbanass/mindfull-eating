{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["@cloudflare/workers-types"],

    /* Bundler mode (Wrangler używa esbuild) */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  // drizzle.config.ts jest celowo poza "include": ono działa pod Node
  // (process.env), a workers-types koliduje z typami Node (Response,
  // Headers, ...) w jednym tsconfig. drizzle-kit i tak nie type-checkuje
  // configu przez ten plik przy uruchomieniu.
  "include": ["src"]
}
